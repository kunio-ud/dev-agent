{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Traceability Master",
  "description": "Lifecycle traceability from requirements to test results",
  "type": "object",
  "properties": {
    "project": { "type": "string" },
    "version": { "type": "string" },
    "last_updated": { "type": "string", "format": "date-time" },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^(BR|FR|NFR|AC)-[0-9]+$" },
          "type": { "enum": ["BR", "FR", "NFR", "AC"] },
          "description": { "type": "string" },
          "links": {
            "type": "array",
            "items": { "type": "string" },
            "description": "IDs of linked artifacts (SCR, API, TBL, FLOW, TV, TC)"
          },
          "status": { "enum": ["Proposed", "Defined", "Implemented", "Verified"] }
        },
        "required": ["id", "type", "status"]
      }
    },
    "designs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^(SCR|API|TBL|FLOW)-[0-9]+$" },
          "type": { "enum": ["SCR", "API", "TBL", "FLOW"] },
          "links": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["id", "type"]
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^(TV|TC|UT)-[0-9]+$" },
          "type": { "enum": ["TV", "TC", "UT"] },
          "links": {
            "type": "array",
            "items": { "type": "string" }
          },
          "result": { "enum": ["Pass", "Fail", "Pending", "N/A"] }
        },
        "required": ["id", "type", "result"]
      }
    }
  },
  "required": ["project", "requirements"]
}
